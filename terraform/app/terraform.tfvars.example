# ==============================================================================
# Finance Tracker — Application Infrastructure Variables Example
# Copy to terraform.tfvars and customize before running terraform plan.
#
# NOTE: terraform.tfvars is ignored by Git and should NEVER be committed.
# ==============================================================================

# Target AWS Region (default: ap-south-1 Mumbai)
aws_region   = "ap-south-1"
project_name = "finance-tracker"
environment  = "prototype"

# Networking Configuration
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidr    = "10.0.1.0/24"
private_subnet_a_cidr = "10.0.10.0/24"
private_subnet_b_cidr = "10.0.11.0/24"

# Inbound Web Traffic (port 80)
allowed_http_cidr_blocks = ["0.0.0.0/0"]

# Inbound HTTPS (port 443)
# Keep false unless you have configured a custom domain name and SSL/TLS certificate
enable_https_ingress = false

# Administrator SSH Access (port 22)
# Keep empty [] by default; AWS Systems Manager Session Manager provides secure keyless access
admin_ssh_cidr_blocks = []

# EC2 Compute Host
ec2_instance_type = "t3.micro"
ec2_volume_size   = 20
assign_elastic_ip = true

# RDS Database Configuration
rds_instance_class      = "db.t3.micro"
rds_allocated_storage   = 20
rds_engine_version      = "8.0"
db_name                 = "financedb"
db_username             = "financeuser"
rds_deletion_protection = true # Safer default. Set to false only when tearing down the prototype
skip_final_snapshot     = true
backup_retention_period = 1

# REQUIRED EPHEMERAL SECRETS (Terraform 1.11+ / AWS Provider 5.88+):
# These values are write-only (password_wo / value_wo) and NEVER saved to state or plan files.
# Supply via environment variables (TF_VAR_db_password, TF_VAR_flask_secret_key)
# or pass interactively at plan/apply time:
db_password         = "CHANGE_ME_TO_A_STRONG_PASSWORD_12+"
db_password_version = 1

flask_secret_key         = "CHANGE_ME_TO_A_32_CHAR_CRYPTOGRAPHIC_KEY_HERE!"
flask_secret_key_version = 1

# Optional: Google Gemini Flash API Key (if empty, falls back to rule-based analysis)
gemini_api_key         = ""
gemini_api_key_version = 1

# S3 Reports Bucket
# Leave null to auto-generate: finance-tracker-reports-<account_id>
s3_bucket_name = null

# Monitoring & Alarms
log_retention_days = 7

# Application URL & Source Configuration:
# - Leave application_url as null to auto-populate with http://<elastic_ip> for password resets
# - If configuring a custom domain, provide the full base URL (e.g. "http://finance.example.com")
# - NOTE: Do NOT use https:// unless an SSL/TLS certificate and custom domain/load balancer are configured
application_url = null

# Optional: Public Git repository URL to clone at launch (no credentials or tokens)
# If null, deploy source files manually via SSM Session Manager or your CI/CD pipeline
app_repo_url = null

# CROSS-ROOT INTEGRATION:
# Paste the alerts_sns_topic_arn output from terraform/budget here to link the EC2 CPU alarm
# to the shared budget alerts SNS topic:
sns_topic_arn = "arn:aws:sns:ap-south-1:123456789012:finance-tracker-budget-alerts"
