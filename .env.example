
# .env.example — copy this file to .env for local development
# DO NOT commit the real .env file (it is excluded by .gitignore).

# ------------------------------------------------------------------
# Flask core settings
# ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Set to 1 ONLY while actively debugging on your local machine.
# Leave unset (or 0) in staging / production.
FLASK_DEBUG=0

# Set to "development" locally, "production" on the server.
FLASK_ENV=development

# ------------------------------------------------------------------
# Application base URL (IMPORTANT for password-reset email links)
# ------------------------------------------------------------------
# This is the public-facing origin of your application.
# It is used to construct absolute URLs in security-sensitive emails
# (e.g. password-reset links) so that the HTTP Host header is never
# trusted to build links that are sent to users.
#
# Local development:
APPLICATION_URL=http://127.0.0.1:5000
#
# Production (uncomment and replace with your real domain):
# APPLICATION_URL=https://financetracker.example.com

# ------------------------------------------------------------------
# Database configuration options
# ------------------------------------------------------------------
# Option A (Local Development): Leave unset to default to local SQLite (instance/finance.db)
#
# Option B (Unified URL - RDS / Cloud):
# DATABASE_URL=mysql+pymysql://username:password@host:3306/financedb
# Note: If your password contains URL reserved characters (@, :, /, ?, #), percent-encode them.
#
# Option C (Discrete Parameters - Docker Compose):
# DB_HOST=db
# DB_PORT=3306
# DB_USER=financeuser
# DB_PASSWORD=replace-with-a-secure-db-password
# DB_NAME=financedb
# DB_DRIVER=mysql+pymysql
# Note: When using discrete parameters, SQLAlchemy automatically escapes passwords with special characters.

# ------------------------------------------------------------------
# Optional integrations
# ------------------------------------------------------------------
# Google Gemini API key for AI financial insights.
# If absent, the application falls back to rule-based insights automatically.
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Production SMTP Email Delivery (for Password Reset)
# ------------------------------------------------------------------
# In development, password reset links are displayed directly in the UI if SMTP is unconfigured.
# For production email delivery, configure an SMTP provider (e.g. Amazon SES, SendGrid, Gmail):
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=smtp-username
# MAIL_PASSWORD=smtp-password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
# MAIL_USE_TLS=1

# ------------------------------------------------------------------
# Docker Compose local MySQL settings (used with docker-compose.yml)
# ------------------------------------------------------------------
MYSQL_DATABASE=financedb
MYSQL_USER=financeuser
MYSQL_PASSWORD=replace-with-a-secure-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-secure-root-password

# ------------------------------------------------------------------
# Amazon S3 Monthly Reports Storage
# ------------------------------------------------------------------
# S3 bucket for archiving user monthly transaction reports.
# The bucket must be kept private (no public access).
# When running on AWS EC2, authentication uses the instance IAM role (no AWS keys in .env).
# For local testing, configure AWS CLI credentials or mock S3 operations.
# S3_REPORT_BUCKET=my-finance-tracker-reports-bucket
# AWS_REGION=us-east-1




